{
  "name": "nexusdocs-phone-companion",
  "version": "1.0.0",
  "description": "Cross-platform desktop app for NexusDocs Phone Companion - Stream phone camera to NexusDocs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:windows": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac",
    "build:all": "electron-builder --win --linux --mac",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "nexusdocs",
    "phone",
    "companion",
    "camera",
    "streaming",
    "websocket"
  ],
  "author": "NexusDocs Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "opencv4nodejs": "^6.0.1",
    "ws": "^8.16.0"
  },
  "build": {
    "appId": "com.nexusdocs.phone-companion",
    "productName": "NexusDocs Phone Companion",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.icns"
    }
  }
}
